commutativity {
   {f1(i_1)}, {f1(i_2)} : (i_1 != i_2)
}

int main(int argc, string[] argv) {
    int i = 1;
    string[] digest = new string[16];
    int i_1 = 0;
    int i_2 = 0;

    while (i < argc){
        f1(i):{
            int j = 0;
            string temp = "";
            string s = "";
            string filename = argv[i];
            while (j < 10) { /* Artificially increase workload by 10x */
                j = j+1;
                
                in_channel c = open_read(filename);
                s = read_line(c);
                temp = string_of_int(md5_lower(s));
            
                close(c);
            }
            digest[i] = temp;
            print(digest[i]);
            print("\n");

            /* Block locals are part of verify's state; reset them so
               the two orders end in the same state. */
            temp = "";
            s = "";
            filename = "";
        }
        i = i + 1;
    }

    return 0;
}


