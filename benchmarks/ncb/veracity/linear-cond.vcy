int x = 0;
int y = 0;

commutativity{
	{f1(z)}, {f2()}: (y > 0 || 0 == y && x + 2 == z)
}
int main(int argc, string[] argv) {
	int size = int_of_string(argv[1]);
	
	x = int_of_string(argv[2]);
	y = int_of_string(argv[3]);
	int z = int_of_string(argv[4]);


	f1(z):{ 
		busy_wait(size);
		if (y > 0) {
			x = x + 2;
		} else {
			x = z;
		}
	}
	f2():{ x = x + 1; y = y + 1; busy_wait(size); }
	

	print(
		string_of_int(x) ^ " " ^ 
		string_of_int(y) ^ " " ^ 
		string_of_int(z) ^ "\n"
	);

	return 0;
}
