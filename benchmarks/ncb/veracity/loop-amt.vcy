
int ctr = 0; 
int amt = 2;
commutativity {
    {f(i_1)},{g()} : (i_1 % 2 == 0 && (ctr > 0 && amt > 0 || ctr <= 0 && amt < -ctr))
}
int main(int argc, string[] argv) {
    int i = int_of_string(argv[1]);
    int i_1 = 0;
    int n = i;
    int amt_pre = 0;
    int i_pre = 0;
    ctr = int_of_string(argv[2]);
    f(i) :
        {
            /* this only works if i is initially even. */
            amt_pre = amt;
            i_pre = i;
            while(i>0) invariant ( amt == amt_pre || i_pre%2!=0 ) { 
                if(i%2 == 0) {
                    amt = amt * -1;
                } else {
                    amt = amt * i * -1;
                }
                i = i - 1;
            }
            ctr = ctr + amt;
            i = 0; amt = 0; i_pre = 0; amt_pre = 0;
        }
    g() :
        {   
            if (ctr > 0) { ctr = ctr - 1; } busy_wait(n);
        }
    
    return 0;
}
