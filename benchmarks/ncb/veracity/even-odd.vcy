int x = 0;

commutativity{
  {f1(y)}, {f2(y)}: (x % 2 == x + y && 0 != y || 0 == y)
}

int main(int argc, string[] argv) {
    int n = int_of_string(argv[1]);
    x = int_of_string(argv[2]);
    int y = int_of_string(argv[3]);

    f1(y):{ 
      busy_wait(n);
      if (x % 2 == 0){
        x = x + y;
      } 
    }
    f2(y):{ 
      if(x % 2 == 1){
        x = x + y;
      }
      busy_wait(n);
    }
    
    return x;
}
