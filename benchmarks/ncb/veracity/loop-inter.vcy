int x = 0;
int y = 0;

commutativity {
    {f1()}, {f2()}: (0 == x && 0 != y || 0 == y)
}

int main(int argc, string[] argv) {
    x = int_of_string(argv[1]);
    y = int_of_string(argv[2]);
    int n = int_of_string(argv[3]);
    int s1 = 0;
    int s2 = 0;
    int acc = 0;
    

    f1():{
        
        while(x>0) invariant true { x = x - 1;  busy_wait(n); s1 = s1 + 1; }
        acc = acc + s1;
    }
    f2():{
    
        while(y>0) invariant true { y = y - 1;  busy_wait(n); s2 = s2 + x; }
        acc = acc + s2;
    }
    
    return 0;
}
