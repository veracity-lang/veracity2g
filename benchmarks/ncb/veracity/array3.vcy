int a = 0;

commutativity {
    {f1(b,e)}, {f2(d)}: (!(d == e) && !(a == b) || a == b)
}

int main(int argc, string[] argv) {
    int b = 0;
    int c = 0;
    int d = 0;
    int n = int_of_string(argv[1]);
    int[] arr = new int[10];
    
    int e = c % n;

    f1(b,e): { busy_wait(n); a = a + 1; arr[e] = b; a = a - 1; }
    f2(d): { arr[d] = a; busy_wait(n); }
    
    return 0;
}

