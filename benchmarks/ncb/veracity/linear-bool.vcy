int x = 0;
int y = 0;

commutativity{
	{f1()}, {f2()}: (y < 0 - 3 * x && x == 2 || y >= 0 && x == 3)
}
int main(int argc, string[] argv) {
	int size = int_of_string(argv[1]);
	x = int_of_string(argv[2]);
	y = int_of_string(argv[2]);
	int b = 0;
	
	f1():{ busy_wait(size); y = y + 3*x; }
	f2():{ if (y < 0) { x = 2; } else { x = 3; } busy_wait(size); }
	

	return x;
}
