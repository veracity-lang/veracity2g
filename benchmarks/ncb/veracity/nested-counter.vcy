int main(int argc, string[] argv) {
    int n = int_of_string(argv[1]);
    int x = 500;
    int y = random(0, 100);
    int c = 420;
    int t = 500;

    commute _  /* 2nd Condition */ {
        { commute _ /* 1st Condition */ { 
              { c = c + 1; } 
              { /*t=*/ busy_wait(n); if(c>0) { c = c - t; } }
          } }
        { t = x;
          busy_wait(n); 
            if(c>t) { x = x - c; } }
    }

    return x;
}
