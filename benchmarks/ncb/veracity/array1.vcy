int[] r = new int[1];

commutativity {
    {f1()}, {f2(y)}: (!(1 == r[0]) && !(y == r[0] + 1) && !(r[0] > 1) || y == r[0] + 1 && !(r[0] > 1))
}

int main(int argc, string[] argv) {
    int n = int_of_string(argv[1]);
    int x = int_of_string(argv[2]);
    int y = int_of_string(argv[3]); 
    r[0] = x;

    f1():{ r[0] = r[0] + 1; busy_wait(n); } 
    f2(y):{ if(r[0] > 1) { r[0] = y; }
      busy_wait(n);
    }
    
    
    return r[0];
}
