/* hist_shared_index on one line per statement group: spawn points on the same
   line must still run in source order. */
int[] hist = new int[16];
int main(int argc, string[] argv) {
    int n = int_of_string(argv[1]);
    int i = 0;
    int a = 0;
    int sum = 0;
    int k = 0;
    while (i < n) { a = i % 16; hist[a] = hist[a] + i; i = i + 1; }
    while (k < 16) { sum = sum * 3 + hist[k]; k = k + 1; }
    return sum;
}
