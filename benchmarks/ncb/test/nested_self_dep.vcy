/* The inner loop becomes a Doall task with one job per outer iteration,
   each spawning jobs of c, which depends on itself.  A job of c waits only
   on the jobs of c registered before it, so they must be registered in
   program order: before Exe_pdg.order_spawners, the inner loop's jobs ran
   in parallel, the later (faster) ones registered first, and the result
   changed from run to run. */
int[] acc = new int[1];

int main(int argc, string[] argv) {
    int i = 0;
    while (i < 6) {
        int j = 0;
        while (j < 4) {
            busy_wait(20000 * (6 - i));
            c(i, j):{
                acc[0] = acc[0] * 3 + i * 4 + j + 1;
                acc[0] = acc[0] % 1000003;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return acc[0];
}
