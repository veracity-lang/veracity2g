commutativity{
    {f1(srcA, dstA)}, {f2(srcB, dstB)} : ((dstA != srcB) && (srcA != dstB) && (dstA != dstB))
}

int main(int argc, string[] argv) {
    string fname = "a.txt";
	in_channel i = open_read(fname);
    out_channel o = open_write(fname);
	string srcA = argv[1];
	string dstA = argv[2];
	string srcB = argv[3];
	string dstB = argv[4];
	string temp = "";
    int j = 0;
    int k = 0;
    int z = 0;
	
	f1(srcA, dstA): { 
        while(k < 20) {
            k = k + 1;
            cp(srcA, dstA);
        }
	}

	f2(srcB, dstB): { 
        /* amplify problem size 10x */
        while(z < 10) {
            z = z + 1;
        
            i = open_read(srcB);
            o = open_write(dstB);
            temp = read_line(i);
            write(o, temp);
            close(i);
            close(o); 
        }

    }
	
	return 0;
}
