commutativity{
    {f1},{f2}: (true)
}

int main(int argc, string[] argv) {
    int y = int_of_string(argv[1]);
    int z = int_of_string(argv[2]);
    int x = 0;

    f1:{
        while(y>0) { x = x + 1; y = y - 1; }
    }
    f2:{
        while(z>0) { x = x + 1; z = z - 1; }
    }
    
    return 0;
}
