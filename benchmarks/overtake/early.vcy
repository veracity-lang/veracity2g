/* As late.vcy, but f writes x first.  hybrid-locked usually finds f dirty
   and waits (--job-stats: Overtakes denied (dirty)), but it may still skip f
   if it checks between f's start and that write, so only not-started and
   hybrid are held to never skipping a running job.  Every rule must return 3. */
int x = 0;
int[] a = new int[2];
commutativity {
    {f()}, {g()}: (x == 0)
}
int main(int argc, string[] argv) {
    int n = int_of_string(argv[1]);
    f(): { x = 1; busy_wait(n); }
    int y = 0;
    busy_wait(n / 4);
    y = 2;
    g(): { busy_wait(n); a[1] = y; }
    return a[1] + x;
}
