/* g's condition reads x, which f writes only at its end.  y makes g's job
   wait until f is likely running, so the rules get to differ:
   not-started and hybrid must never skip f once it runs; hybrid-locked
   may, since f has not written x yet.  Every rule must return 3. */
int x = 0;
int[] a = new int[2];
commutativity {
    {f()}, {g()}: (x == 0)
}
int main(int argc, string[] argv) {
    int n = int_of_string(argv[1]);
    f(): { busy_wait(n); x = 1; }
    int y = 0;
    busy_wait(n / 4);
    y = 2;
    g(): { busy_wait(n); a[1] = y; }
    return a[1] + x;
}
