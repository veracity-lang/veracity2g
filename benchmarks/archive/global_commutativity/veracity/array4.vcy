commutativity {
    {f1(arr)}, {f2(arr,x)}: (0 > arr[0] && !(1 == x) || 1 == x);
    {f3(a,b,e)}, {f4(a,d)}: (!(d == e) && !(a == b) || a == b);
    {f1(arr)}, {f3(a,b,e)}: (!(0 == e));
    {f2(arr,x)}, {f4(a,d)}: (!(a > d) && !(d == a) && !(1 == x) || !(0 == d) && a > d && !(d == a) && !(1 == x) || d == a && !(1 == x) || 1 == x)
}

int main(int argc, string[] argv) {
    int a = 0;
    int b = 0;
    int c = 0;
    int d = 0;
    int n = int_of_string(argv[1]);
    int[] arr = new int[2000];
 
    int x = int_of_string(argv[2]);
    
    int e = c % n;
    arr[0] = 69;
    mutex_init(0); 

    f1(arr):{ busy_wait(n); mutex_lock(0); arr[0] = arr[0] + 1; mutex_unlock(0); }
    f2(arr,x):{ mutex_lock(0);  if(arr[0] > 0) {arr[0] = arr[0] * x; } mutex_unlock(0); busy_wait(n); }
    f3(a,b,e): { busy_wait(n); mutex_lock(0); a = a + 1; arr[e] = b; a = a - 1; mutex_unlock(0); }
    f4(a,d): { arr[d] = a; busy_wait(n); }
    
    return 0;
}

