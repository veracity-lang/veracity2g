/* phi mentions x, which the loop body writes, so it need not hold at the
   later swaps and the abstraction must not fire. */
int main(int argc, string[] argv) {
    int k = 0;
    int x = 0;
    int y = 0;
    commute (x < 5) {
        { while (k < 10) { k = k + 1; x = x + 1; } }
        { if (x < 5) { y = 1; } }
    }
    return 0;
}
