/* f2 writes the loop bound n, so the iteration count depends on the order
   and the abstraction must not fire. */
int main(int argc, string[] argv) {
    int k = 0;
    int n = 10;
    int x = 0;
    commute (true) {
        { while (k < n) { k = k + 1; x = x + 1; } }
        { n = n + 1; }
    }
    return 0;
}
