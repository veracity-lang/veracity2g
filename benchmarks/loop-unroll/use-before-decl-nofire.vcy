/* In each iteration the body reads the outer z before declaring its own z
   (the shape of the original commset benchmark).  Inlined copies would make
   the second iteration read the first iteration's z.  The loop must not be
   unrolled.  Expect: "cannot translate this loop". */
commutativity {
    {f(i_1)}, {f(i_2)} : (true)
}

int main(int argc, string[] argv) {
    int[] a = new int[10];
    int z = 0;
    int i = 0;
    int i_1 = 0;
    int i_2 = 0;
    while (i < 2) {
        f(i): {
            int k = 0;
            while (k < 3) {
                a[0] = a[0] + z;
                int z = 7;
                k = k + 1;
            }
        }
        i = i + 1;
    }
    return 0;
}
