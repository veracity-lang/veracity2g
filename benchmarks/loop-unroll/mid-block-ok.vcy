/* A loop with a literal trip count in the middle of a block, after a reset
   of its counter, is unrolled.  Both blocks only add to a[], so they
   commute.  Expect: correct. */
commutativity {
    {f(i_1)}, {f(i_2)} : (true)
}

int main(int argc, string[] argv) {
    int[] a = new int[10];
    int i = 0;
    int i_1 = 0;
    int i_2 = 0;
    while (i < 2) {
        f(i): {
            int k = 0;
            a[0] = a[0] + 1;
            k = 0;
            while (k < 5) {
                a[k] = a[k] + 1;
                k = k + 1;
            }
        }
        i = i + 1;
    }
    return 0;
}
